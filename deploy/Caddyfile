{
  email {$ACME_EMAIL}
}
{$DOMAIN} {
  encode zstd gzip
  header {
    X-Content-Type-Options nosniff
    Referrer-Policy no-referrer
    X-Frame-Options DENY
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Strict-Transport-Security "max-age=31536000"
    Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; worker-src 'self'; manifest-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
  }
  handle /api/* {
    reverse_proxy api:3001
  }
  handle {
    root * /srv
    @versioned path /assets/*
    header @versioned Cache-Control "public, max-age=31536000, immutable"
    @shell path / /index.html /sw.js /manifest.webmanifest
    header @shell Cache-Control "no-cache"
    try_files {path} /index.html
    file_server
  }
  # Do not log query strings: invitation tokens must never appear in access logs.
}
