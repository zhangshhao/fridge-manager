NODE_ENV=production
HOST=0.0.0.0
PORT=3001
APP_ORIGIN=https://fridge.example.com
DOMAIN=fridge.example.com
ACME_EMAIL=admin@example.com
RELEASE=1.0.0
POSTGRES_PASSWORD=replace_with_long_random_password
# URL-encode password if it contains reserved URI characters.
DATABASE_URL=postgresql://fridge:replace_with_long_random_password@postgres:5432/fridge?schema=public
SESSION_DAYS=14
AI_API_KEY=
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_MODEL=qwen-plus
AI_USER_DAILY_LIMIT=20
AI_FAMILY_DAILY_LIMIT=50
AI_TIMEOUT_MS=25000
AI_MAX_CONCURRENT=2
PRIVACY_CONTACT=请填写实际联系渠道
# Restic encrypts remote backups. The repository must be on a separate storage service.
RESTIC_REPOSITORY=s3:https://s3.example.com/private-fridge-backups
RESTIC_PASSWORD=replace_with_long_random_backup_password
AWS_ACCESS_KEY_ID=replace_me
AWS_SECRET_ACCESS_KEY=replace_me
# Optional monitoring endpoint; failure to back up returns nonzero to the scheduler.
BACKUP_SUCCESS_URL=
BACKUP_FAILURE_URL=
